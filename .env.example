# Variables de entorno — copia este archivo como .env y llena los valores

# Base de datos SQL Server
DB_SERVER=72.167.143.255
DB_PORT=1434
DB_NAME=LM5K
DB_USER=appdelivery
DB_PASSWORD=

# JWT
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio

# Servidor
PORT=3000

# CORS — dominios permitidos (separa con coma, o deja * para todos)
ALLOWED_ORIGINS=*

# Pagos
# KLU_MOCK (simulado), KLU_MANUAL_TRANSFER (transferencia) o STRIPE
PAYMENT_PROVIDER=KLU_MANUAL_TRANSFER
PAYMENT_CURRENCY=MXN
PAYMENT_EXPIRY_MINUTES=30
PAYMENT_COMMISSION_RATE=0.03

# Cuenta destino de la transferencia (ej. CLABE o cuenta concentradora)
PAYMENT_DESTINATION_ACCOUNT=

# Checkout público (para construir links / QR)
PUBLIC_CHECKOUT_BASE_URL=http://localhost:3000

# Stripe (solo en .env real, nunca subas llaves al repo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2025-04-30.basil
